# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The Odds API
ODDS_API_KEY=your-odds-api-key

# Google Gemini API (Multimodal OCR / Extraction)
GEMINI_API_KEY=your-gemini-api-key

# Grupo e Membros (separados por vírgula)
NEXT_PUBLIC_GROUP_MEMBERS=Lopes,Carlos,Igor,Mouse
NEXT_PUBLIC_INITIAL_BALANCE=100.00

# Chave de Administração para rotas internas
ADMIN_SECRET=your-admin-secret-key
